[node name="HelpText" type="Label" parent="Content/HelpPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 12
text = "WASD 移动    鼠标瞄准    左键射击    R 换弹
Shift 或空格 冲刺（无敌、有冷却）
1~9 或滚轮 换枪（随身最多 4 把，商店可扩到 5 把）
Q 或中键 用道具    E 切道具
0 医疗包    - 手雷    = 核弹
Esc 或 P 暂停    F11 或 F 全屏
目标：守住基地，撑过 15 波即胜利
失败：基地被摧毁，或玩家生命归零
波次之间打开商店，解锁武器、买道具、修墙、放炮塔
玩家可穿过路障，僵尸不行
偶数波和第 15 波是 Boss 战，地上亮红圈就快躲
天气和空投等随机事件看屏幕提示和右上角标签
精英的克制办法见标题界面的「僵尸图鉴」"

