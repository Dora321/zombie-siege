horizontal_alignment = 1

[node name="HelpText" type="Label" parent="HelpPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 12
text = "WASD 移动    鼠标瞄准    左键射击    R 换弹
Shift 或空格 冲刺（无敌、有冷却）
1~9 或滚轮 换枪（4~9 要在商店解锁）
Q 或中键 用道具    E 切道具
0 医疗包    - 手雷    = 核弹
Esc 或 P 暂停    F11 或 F 全屏

目标：守住中央基地，撑过 15 波即胜利
失败：基地被摧毁，或玩家生命归零
波次之间打开商店，解锁武器、买道具、修墙
放炮塔。玩家可穿过路障，僵尸不行
第 5、10、15 波是 Boss 阶段战，地上亮红圈就快躲
各种精英的克制办法见标题界面的「僵尸图鉴」"

