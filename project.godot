; Godot 4 工程配置
config_version=5

[application]

config/name="僵尸围城 Zombie Siege"
config/description="纯 GDScript 程序化生成的 2D 像素风俯视角生存射击游戏"
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07, 0.06, 0.09, 1)

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
Save="*res://scripts/autoload/save.gd"
Art="*res://scripts/autoload/art.gd"
Sfx="*res://scripts/autoload/sfx.gd"
WindowFit="*res://scripts/autoload/window_fit.gd"
Harness="*res://scripts/test/harness.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://resources/pixel_theme.tres"

