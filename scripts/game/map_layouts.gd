static func grid(id: String) -> Array:
	return GRIDS.get(id, [])


## 选图界面的缩略图：每格 2 像素，颜色取自 GameData.MAPS 的 preview 色板。
static func preview(id: String) -> Image:
	var spec: Dictionary = GameData.MAPS[id]
	var pal: Dictionary = spec["preview"]
	var img := Image.create_empty(64, 44, false, Image.FORMAT_RGBA8)
	img.fill(Color(String(pal["floor"])))
	var rows := grid(id)
	if rows.is_empty():
		_sketch_ruins(img, pal)
	else:
		for y in rows.size():
			var row: String = rows[y]
			for x in row.length():
				var c := _preview_color(row[x], pal)
				if c.a > 0.0:
					img.set_pixel(x, y, c)
	img.resize(128, 88, Image.INTERPOLATE_NEAREST)
	return img


static func _preview_color(ch: String, pal: Dictionary) -> Color:
	match ch:
		"#":
			return Color(String(pal["solid"]))
		"W":
			return Color("#d8d4c8")
		"B":
			return Color("#a07840")
		"H":
			return Color("#5a90d0")
		"C", "c", "L", "D":
			return Color(String(pal["prop"]))
		"R":
			return Color("#d84030")
	return Color(0, 0, 0, 0)


## 废墟街区的示意图：十字路、围墙环、散落的树。
static func _sketch_ruins(img: Image, pal: Dictionary) -> void:
	img.fill_rect(Rect2i(0, 20, 64, 4), Color(String(pal["road"])))
	img.fill_rect(Rect2i(30, 0, 4, 44), Color(String(pal["road"])))
	img.fill_rect(Rect2i(23, 14, 18, 16), Color(String(pal["road"])))
	var rng := RandomNumberGenerator.new()
	rng.seed = 7
	for i in 60:
		var x := rng.randi_range(1, 62)
		var y := rng.randi_range(1, 42)
		if (x >= 21 and x <= 42 and y >= 12 and y <= 31) or (y >= 19 and y <= 24) or (x >= 29 and x <= 34):
			continue
		img.set_pixel(x, y, Color(String(pal["prop"])))
	for x in range(23, 41):
		for y: int in [14, 29]:
			img.set_pixel(x, y, Color("#a07840") if x >= 30 and x <= 33 else Color("#d8d4c8"))
	for y in range(14, 30):
		for x: int in [23, 40]:
			img.set_pixel(x, y, Color("#a07840") if y >= 20 and y <= 23 else Color("#d8d4c8"))
	img.fill_rect(Rect2i(30, 20, 4, 3), Color("#5a90d0"))
